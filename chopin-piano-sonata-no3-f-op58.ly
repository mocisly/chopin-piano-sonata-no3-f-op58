% Restore the wider source indentation at each later movement opening.
% The native continuous score otherwise applies short-indent to these systems.
% Moving complete rhythmic columns preserves native glyph sizes and keeps the
% right staff boundary fixed. Only the three movement-opening systems change.
#(define (op58-visible-rest-positioning grob)
   (let* ((array (ly:grob-object grob 'elements))
          (columns (if (ly:grob-array? array) (ly:grob-array->list array) '()))
          (visible (filter
            (lambda (column)
              (let ((rest (ly:grob-object column 'rest)))
                (or (not (ly:grob? rest))
                    (and (not (ly:grob-property rest 'transparent #f))
                         (not (eq? #f (ly:grob-property-data rest 'stencil)))))))
            columns)))
     (when (ly:grob-array? array)
       (ly:grob-set-object! grob 'elements (ly:grob-list->grob-array visible)))
     (if (or (null? visible)
             (any
               (lambda (column)
                 (let* ((rest (ly:grob-object column 'rest))
                        (attrs (if (ly:grob? rest) (ly:grob-property rest 'output-attributes '()) '())))
                   (equal? "r5-104" (assoc-get 'data-nid attrs ""))))
               visible))
         #t
         (ly:rest-collision::calc-positioning-done grob))))

#(define op58-movement-start-indents '((817/4 . 5) (733/2 . 5) (15561/32 . 5)))
#(define op58-indented-systems (make-hash-table))
#(define op58-tempo-words (make-hash-table))
#(define op58-metronome-word-pairs
   '(("op58-direction-00003-metronome" . "op58-direction-00001-words")
     ("op58-direction-01366-metronome" . "op58-direction-01365-words")
     ("op58-direction-01542-metronome" . "op58-direction-01541-words")
     ("op58-direction-02337-metronome" . "op58-direction-02335-words")))
#(define (op58-align-structural-metronome grob)
   (let* ((attrs (ly:grob-property grob 'output-attributes '()))
          (did (assoc-get 'data-did attrs ""))
          (pair (assoc did op58-metronome-word-pairs))
          (word (and pair (hash-ref op58-tempo-words (cdr pair) #f))))
     (if (ly:grob? word)
       (let* ((x-ref (ly:grob-common-refpoint grob word X))
              (y-ref (ly:grob-common-refpoint grob word Y))
              (word-x (ly:grob-extent word x-ref X))
              (mark-x (ly:grob-extent grob x-ref X))
              (word-y
                (cond
                  ((equal? did "op58-direction-02337-metronome")
                    (+ (ly:grob-relative-coordinate (op58-source-staff-symbol grob 1) y-ref Y) 6.7))
                  ((equal? did "op58-direction-01366-metronome")
                    (+ (ly:grob-relative-coordinate (op58-source-staff-symbol grob 1) y-ref Y) 5.651063))
                  (else (ly:grob-relative-coordinate word y-ref Y))))
              (mark-y (ly:grob-relative-coordinate grob y-ref Y)))
         (ly:grob-translate-axis! grob (- (+ (cdr word-x) 1.5) (car mark-x)) X)
         (ly:grob-translate-axis! grob (- word-y mark-y) Y)))))

% Preserve the source hierarchy of movement title above tempo wording.
% The four retained BPM marks follow their tempo text on the same baseline.
% All 670 native tempo events and the optional full-mark display remain intact.
#(define (op58-movement-heading-engraver context)
   (make-engraver
     (acknowledgers
       ((grob-interface engraver grob source-engraver)
        (when (eq? 'TextScript (assoc-get 'name (ly:grob-property grob 'meta)))
          (let* ((attrs (ly:grob-property grob 'output-attributes '()))
                 (did (assoc-get 'data-did attrs "")))
            (when (member did (map cdr op58-metronome-word-pairs))
              (hash-set! op58-tempo-words did grob)
              (ly:grob-set-property! grob 'outside-staff-priority 450))
            (when (member did '("op58-direction-01364-words" "op58-direction-02336-words"))
              (ly:grob-set-property! grob 'outside-staff-priority 700)
              (when (equal? did "op58-direction-02336-words")
                (ly:grob-set-property! grob 'script-priority 400)))
            (when (assoc did op58-metronome-word-pairs)
              (ly:grob-set-property! grob 'outside-staff-priority #f)
              (ly:grob-set-property! grob 'Y-extent '(0 . 0))
              (ly:grob-set-property! grob 'after-line-breaking op58-align-structural-metronome))))))))

#(define (op58-place-movement-starts system)
   (if (not (hashq-ref op58-indented-systems system))
     (begin
       (hashq-set! op58-indented-systems system #t)
       (let* ((array (ly:grob-object system 'columns))
              (columns (if (ly:grob-array? array) (ly:grob-array->list array) '()))
              (first (and (pair? columns) (car columns)))
              (last-column (and (pair? columns) (car (reverse columns))))
              (moment (and first (ly:grob-property first 'when)))
              (start (and (ly:moment? moment) (ly:moment-main moment)))
              (entry (and start (assoc start op58-movement-start-indents))))
         (if entry
           (let* ((x0 (ly:grob-relative-coordinate first system X))
                  (x1 (ly:grob-relative-coordinate last-column system X))
                  (width (- x1 x0))
                  (indent (cdr entry)))
             (if (> width indent)
               (for-each
                 (lambda (column)
                   (let* ((x (ly:grob-relative-coordinate column system X))
                          (dx (* indent (- 1 (/ (- x x0) width)))))
                     (ly:grob-translate-axis! column dx X)))
                 columns))))))))

% Native dots only: preserve glyph, count and Y while choosing a clear X
% relative to the owning source NoteHead, after DotColumn has positioned.
#(define (op58-owned-glyph-x-from-head distance)
   (lambda (dot)
     (let* ((head (ly:grob-parent dot Y))
            (reference (ly:grob-common-refpoint dot head X))
            (target (+ (ly:grob-relative-coordinate head reference X) distance))
            (current (ly:grob-relative-coordinate dot reference X)))
       (ly:grob-translate-axis! dot (- target current) X))))
#(define op58-dot-x-from-head op58-owned-glyph-x-from-head)

% Four independently reviewed accidentals; preserve native glyph and Y.
#(define op58-accidental-head-x-anchors
   '(
     ("n5-3091" . -2.255224)
     ("n5-3092" . -3.161861)
     ("n5-3093" . -2.507503)
     ("n5-3094" . -1.372542)
   ))
#(define (op58-reviewed-accidental-x grob)
  (let* ((head (ly:grob-parent grob Y))
         (nid (assoc-get 'data-nid (ly:grob-property head 'output-attributes '()) ""))
         (entry (assoc nid op58-accidental-head-x-anchors)))
    (when entry ((op58-owned-glyph-x-from-head (cdr entry)) grob))))


