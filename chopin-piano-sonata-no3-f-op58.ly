    \consists #op58-tuplet-number-offset-engraver
    \consists #op58-local-grob-offset-engraver
    \consists #op58-span-bar-gap-engraver
    \override System.after-line-breaking = #op58-place-movement-starts
    \override BarNumber.font-size = #-2
    \override BarNumber.break-visibility = #begin-of-line-visible
    \override BarNumber.self-alignment-X = #LEFT
    \override BarNumber.padding = #1.4
    \override MetronomeMark.padding = #2.5
  }
  \context {
    \Staff
    printKeyCancellation = ##f
    pedalSustainStyle = #'bracket
    % Explicit source positions own every visible pedal bracket. Keep their
    % automatic alignment parent from moving the completed native marks again.
    \override SustainPedalLineSpanner.Y-offset = #0
    \override SustainPedalLineSpanner.Y-extent = #'(0 . 0)
    \override SustainPedalLineSpanner.outside-staff-priority = ##f
    \override RestCollision.positioning-done = #op58-visible-rest-positioning
    \override StaffSymbol.thickness = #0.8
  }
  \context {
    \PianoStaff
    \override StaffGrouper.staff-staff-spacing = #'((basic-distance . 13.852) (minimum-distance . 13.852) (padding . 0) (stretchability . 0))
  }
  \context {
    \Voice
    % Every printed DynamicText/Hairpin has a recorded source Y target.
    \override DynamicLineSpanner.Y-offset = #0
    \override DynamicLineSpanner.Y-extent = #'(0 . 0)
    \override DynamicLineSpanner.outside-staff-priority = ##f
    \override TextScript.outside-staff-padding = #0.6
    \override DynamicText.outside-staff-padding = #0.6
  }
}


% All pitches and event durations are native LilyPond. Source-hidden events
% remain editable. Integer-tick tuplet rounding is documented in the manifest.
showAllMetronomeMarks = ##f
optionalMetronome = #(define-music-function (music) (ly:music?)
  (if showAllMetronomeMarks music (make-music 'SequentialMusic 'elements '())))
% LilyPond's pedal alignment engraver may end its last span on an unused
% musical PaperColumn.  Bind only exact score-end pedal spans to the final
% command column at the same moment; no musical duration is changed.
#(define (op58-pedal-final-bound-engraver context)
  (let ((pedals '()))
    (make-engraver
      (acknowledgers
        ((piano-pedal-interface engraver grob source-engraver)
          (if (ly:spanner? grob) (set! pedals (cons grob pedals)))))
      ((finalize engraver)
        (let ((column (ly:context-property context 'currentCommandColumn)))
          (if (ly:grob? column)
            (for-each
              (lambda (grob)
                (let ((right (ly:spanner-bound grob RIGHT)))
                  (if (and (ly:grob? right)
                           (equal? (ly:grob-property right 'when)
                                   (ly:grob-property column 'when)))
                    (ly:spanner-set-bound! grob RIGHT column))))
              pedals)))))))
% The three source ties that change staff have a TieColumn common to both
% staves.  They must not participate in either individual staff's skyline.
% Their actual native Tie outlines stay in the System and in the ink audit.
#(define (op58-foreign-crossstaff-tie-spacing group)
  (let ((elements (ly:grob-object group 'elements)))
    (if (ly:grob-array? elements)
      (ly:grob-set-object! group 'elements
        (ly:grob-list->grob-array
          (filter
            (lambda (grob)
              (not (and (grob::has-interface grob 'tie-interface)
                        (ly:grob-property grob 'cross-staff #f)
                        (not (eq? (ly:grob-common-refpoint group grob Y)
                                  group)))))
            (ly:grob-array->list elements)))))))
#(define (op58-relative-coordinate object reference axis)
  (let ((common (ly:grob-common-refpoint object reference axis)))
    (- (ly:grob-relative-coordinate object common axis)
       (ly:grob-relative-coordinate reference common axis))))
#(define (op58-crossstaff-tie-points grob)
  (let* ((left (ly:spanner-bound grob LEFT))
         (right (ly:spanner-bound grob RIGHT))
         (ss (ly:staff-symbol-staff-space grob))
         (direction (ly:grob-property grob 'direction UP))
         (left-extent (ly:grob-extent left left X))
         (right-extent (ly:grob-extent right right X))
         (x0 (+ (op58-relative-coordinate left grob X)
                (cdr left-extent) (* 0.12 ss)))
         (x3 (+ (op58-relative-coordinate right grob X)
                (car right-extent) (* -0.12 ss)))
         (y0 (+ (op58-relative-coordinate left grob Y)
                (* direction 0.18 ss)))
         (y3 (+ (op58-relative-coordinate right grob Y)
                (* direction 0.18 ss)))
         (dx (- x3 x0)) (dy (- y3 y0))
         (height (* direction ss
                    (min 1.0 (max 0.45 (* 0.12 (/ dx ss)))))))
    (list (cons x0 y0)
          (cons (+ x0 (* 0.33 dx)) (+ y0 (* 0.33 dy) height))
          (cons (- x3 (* 0.33 dx)) (+ y3 (* -0.33 dy) height))
