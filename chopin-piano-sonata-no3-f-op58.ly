#(define (op58-grob-column-moment grob)
   (let loop ((node grob) (depth 0))
     (if (or (not (ly:grob? node)) (> depth 10)) #f
       (let ((moment (ly:grob-property node 'when #f)))
         (if (ly:moment? moment) (ly:moment-main moment)
           (loop (ly:grob-parent node X) (+ depth 1)))))))
#(define (op58-span-bar-gap-engraver context)
   (make-engraver
     (acknowledgers
       ((grob-interface engraver grob source-engraver)
        (when (eq? 'SpanBar (assoc-get 'name (ly:grob-property grob 'meta)))
          (let ((original (ly:grob-property-data grob 'after-line-breaking)))
            (ly:grob-set-property! grob 'after-line-breaking
              (lambda (g)
                (when (procedure? original) (original g))
                (let* ((system (op58-source-system-index g))
                       (moment (op58-grob-column-moment g))
                       (key (list system moment)))
                  (when (member key op58-span-bar-gaps)
                    (ly:grob-set-property! g 'stencil #f)
                    (when (ly:get-option 'audit-links)
                      (ly:message "OP58-SPAN-BAR-GAP system=~a moment=~a" system moment))))))))))))



