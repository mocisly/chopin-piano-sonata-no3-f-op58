#(define (op58-local-grob-offset-engraver context)
   (make-engraver
     (acknowledgers
       ((grob-interface engraver grob source-engraver)
        (let* ((name (assoc-get 'name (ly:grob-property grob 'meta)))
               (attrs (ly:grob-property grob 'output-attributes '()))
               (cause (ly:grob-property grob 'cause))
               (cause-attrs (if (ly:grob? cause)
                 (ly:grob-property cause 'output-attributes '()) '()))
               (entry (find
                 (lambda (row)
                   (and (eq? name (car row))
                     (equal? (list-ref row 2)
                       (let ((value (assoc-get (list-ref row 1) attrs "")))
                         (if (string-null? value)
                           (assoc-get (list-ref row 1) cause-attrs "") value)))))
                 op58-local-grob-offsets)))
          (when entry
            (let ((old (ly:grob-property grob 'extra-offset '(0 . 0))))
              (ly:grob-set-property! grob 'extra-offset
                (cons (+ (car old) (list-ref entry 3))
                      (+ (cdr old) (list-ref entry 4)))))))))))

