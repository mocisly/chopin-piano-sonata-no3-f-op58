% Lower actual page-number ink by four staff spaces, retaining its layout box.
% This keeps all source system frames fixed and clears final pedal brackets.
#(define-markup-command (op-score-footer-ink layout props arg) (markup?)
   (let* ((original (interpret-markup layout props arg))
          (moved (ly:stencil-translate-axis original -4 Y)))
     (ly:make-stencil (ly:stencil-expr moved)
       (ly:stencil-extent original X) (ly:stencil-extent original Y))))
