       (let* ((array (ly:grob-object system 'columns))
              (columns (if (ly:grob-array? array) (ly:grob-array->list array) '()))
              (first (and (pair? columns) (car columns)))
              (moment (and first (ly:grob-property first 'when)))
              (start (and (ly:moment? moment) (ly:moment-main moment)))
              (entry (and start (assoc start op58-source-system-start-indices)))
              (index (if entry (cdr entry) 0)))
         (hashq-set! op58-source-system-index-cache system index)
         index))))

#(define op58-positioned-source-marks (make-hash-table))
#(define op58-translated-native-marks (make-hash-table))
#(define op58-source-staff-cache (make-hash-table))
#(define (op58-source-staff-symbol grob number)
   (let* ((system (ly:grob-system grob))
          (cached (and (ly:grob? system) (hashq-ref op58-source-staff-cache system #f)))
          (staves
            (if cached cached
              (if (ly:grob? system)
                (let* ((array (ly:grob-object system 'all-elements))
                       (elements (if (ly:grob-array? array) (ly:grob-array->list array) '()))
                       (found (filter
                         (lambda (g) (eq? 'StaffSymbol (assoc-get 'name (ly:grob-property g 'meta))))
                         elements)))
                  (hashq-set! op58-source-staff-cache system found)
                  found)
                '()))))
     (or (find
       (lambda (g)
         (equal? (number->string number)
           (assoc-get 'data-voice (ly:grob-property g 'output-attributes '()) "")))
       staves)
       (ly:grob-object grob 'staff-symbol #f))))
#(define (op58-source-mark-identity grob)
   (let* ((attrs (ly:grob-property grob 'output-attributes '()))
          (did (assoc-get 'data-did attrs "")))
     (if (string-null? did) (assoc-get 'data-sid attrs "") did)))
#(define (op58-place-source-mark grob)
   (if (not (hashq-ref op58-positioned-source-marks grob))
     (let* ((entry (assoc (op58-source-mark-identity grob) op58-source-mark-positions))
            (staff (and entry (op58-source-staff-symbol grob (list-ref entry 2)))))
       (when (and entry (ly:grob? staff))
         (hashq-set! op58-positioned-source-marks grob #t)
         (let* ((ref (ly:grob-common-refpoint grob staff Y))
                (staff-y (ly:grob-relative-coordinate staff ref Y))
                (grob-y (ly:grob-relative-coordinate grob ref Y))
                (fragment-key (list (car entry) (op58-source-system-index grob)))
                (offset (assoc fragment-key op58-source-mark-fragment-offsets))
                (wanted (+ staff-y (list-ref entry 3) (if offset (cdr offset) 0))))
           (ly:grob-translate-axis! grob (- wanted grob-y) Y))))))
#(define (op58-translate-native-mark grob)
   (when (not (hashq-ref op58-translated-native-marks grob))
     (let* ((key (list (op58-source-mark-identity grob) (op58-source-system-index grob)))
            (entry (assoc key op58-native-mark-fragment-offsets)))
       (when entry
         (hashq-set! op58-translated-native-marks grob #t)
         ; The native Ottava Y-offset is a lazy side-position callback.  A
         ; coordinate translation here can change the skyline solution that
         ; is still to be evaluated.  extra-offset is applied only at output,
         ; after the native placement, and moves the complete stencil/link.
         (let ((old (ly:grob-property grob 'extra-offset '(0 . 0))))
           (ly:grob-set-property! grob 'extra-offset
             (cons (+ (car old) (list-ref entry 1))
                   (+ (cdr old) (list-ref entry 2)))))))))
#(define (op58-source-mark-engraver context)
   (make-engraver
     (acknowledgers
       ((grob-interface engraver grob source-engraver)
        (let* ((name (assoc-get 'name (ly:grob-property grob 'meta)))
               (identity (op58-source-mark-identity grob))
               (entry (assoc identity op58-source-mark-positions))
               (native-entry (find (lambda (row) (equal? identity (caar row))) op58-native-mark-fragment-offsets)))
          (when (or (and entry (eq? name (list-ref entry 1)))
                    (and native-entry (member name '(OttavaBracket DynamicText))))
            (let ((original (ly:grob-property-data grob 'after-line-breaking)))
              (when entry (ly:grob-set-property! grob 'outside-staff-priority #f))
              (when (member (op58-source-mark-identity grob) '("op58-direction-02335-words" "op58-direction-02336-words" "op58-direction-01364-words" "op58-direction-01365-words"))
                (ly:grob-set-property! grob 'Y-offset 0))
              (when entry (ly:grob-set-property! grob 'Y-extent '(0 . 0)))
              (ly:grob-set-property! grob 'after-line-breaking
                (lambda (g)
                  (when (procedure? original) (original g))
                  (when (equal? (op58-source-mark-identity g) "op58-direction-01841-pedal")
                    (ly:grob-set-property! g 'edge-height '(1 . 0.25))
                    (ly:grob-set-property! g 'stencil (ly:piano-pedal-bracket::print g))
                    (score-ink-audit-wrap-stencil! g))
                  (op58-place-source-mark g)
                  (op58-translate-native-mark g))))))))))

