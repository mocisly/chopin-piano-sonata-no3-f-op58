% Local pure estimate: final native Script placement is deliberately unchanged.
% At XML743 the pure Script callback recursively reaches the same staff through
% a foreign cross-staff Stem.  Its own chord supplies a safe pure estimate.
#(define op58-script-local-y
  (ly:make-unpure-pure-container
    (lambda (grob) (ly:unpure-call script-interface::calc-y-offset grob))
    (lambda (grob start end)
      (let ((sid (assoc-get 'data-sid (ly:grob-property grob 'output-attributes '()) #f)))
        (* (if (equal? sid "op58-art-n5-678-staccato") -0.75 -2.25)
           (ly:staff-symbol-staff-space grob))))))

#(define op58-noteheads-by-nid (make-hash-table 18000))
#(define op58-native-tie-free-edges (make-hash-table 256))
#(define (op58-source-notehead-engraver context)
  (make-engraver
    ((initialize engraver)
      (set! op58-noteheads-by-nid (make-hash-table 18000))
      (set! op58-native-tie-free-edges (make-hash-table 256)))
    (acknowledgers
      ((note-head-interface engraver grob source-engraver)
        (let ((nid (assoc-get 'data-nid
                     (ly:grob-property grob 'output-attributes '()) #f)))
          (if nid (hash-set! op58-noteheads-by-nid nid grob)))))))

#(define (op58-head-centre head reference axis)
  (let ((extent (ly:grob-extent head head axis)))
    (+ (op58-relative-coordinate head reference axis)
       (* 0.5 (+ (car extent) (cdr extent))))))

#(define (op58-same-system-head nid grob)
  (let ((head (hash-ref op58-noteheads-by-nid nid #f)))
    (and (ly:grob? head)
         (eq? (ly:grob-system head) (ly:grob-system grob))
         head)))

#(define (op58-tie-source-points grob)
  (let* ((sid (assoc-get 'data-sid
                (ly:grob-property grob 'output-attributes '()) #f))
         (row (and sid (assoc-get sid op58-tie-head-map #f)))
         (custom (and sid (assoc-get sid op58-tie-point-repairs #f)))
         (native (if (ly:grob-property grob 'cross-staff #f)
                     (op58-crossstaff-tie-points grob)
                     (ly:tie::calc-control-points grob))))
    (if (not row) native
      (let* ((left (ly:spanner-bound grob LEFT))
             (right (ly:spanner-bound grob RIGHT))
             (real-left (op58-same-system-head (car row) grob))
             (real-right (op58-same-system-head (cdr row) grob))
             (ss (ly:staff-symbol-staff-space grob)))
        (if (and custom real-left real-right)
          (map (lambda (offset head)
                 (cons (+ (op58-head-centre head grob X) (* ss (car offset)))
                       (+ (op58-head-centre head grob Y) (* ss (cdr offset)))))
               custom (list real-left real-left real-right real-right))
          (let ((deltas
                  (map
                    (lambda (real support)
                      (if (and real (ly:grob? support)
                               (grob::has-interface support 'note-head-interface))
                        (cons (- (op58-head-centre real grob X)
                                 (op58-head-centre support grob X))
                              (- (op58-head-centre real grob Y)
                                 (op58-head-centre support grob Y)))
                        '(0 . 0)))
                    (list real-left real-right) (list left right))))
            (map
              (lambda (point weight)
                (cons (+ (car point)
                         (* (- 1 weight) (caar deltas))
                         (* weight (caadr deltas)))
                      (+ (cdr point)
                         (* (- 1 weight) (cdar deltas))
                         (* weight (cdadr deltas)))))
              native '(0 1/3 2/3 1))))))))

#(define (op58-fragment-index grob)
  (let* ((original (ly:grob-original grob))
         (fragments (if (ly:grob? original)
                        (ly:spanner-broken-into original) '())))
    (let loop ((rows fragments) (index 0))
      (cond ((null? rows) 0)
            ((eq? (car rows) grob) index)
            (else (loop (cdr rows) (+ index 1)))))))

#(define (op58-reviewed-slur-points grob)
  (let* ((sid (assoc-get 'data-sid
                (ly:grob-property grob 'output-attributes '()) #f))
         (fragments (and sid (assoc-get sid op58-slur-point-offsets #f)))
         (offsets (and fragments
                      (assoc-get (op58-fragment-index grob) fragments #f)))
         (points (ly:slur::calc-control-points grob))
         (ss (ly:staff-symbol-staff-space grob)))
    (if (not offsets) points
      (map (lambda (point offset)
             (cons (+ (car point) (* ss (car offset)))
                   (+ (cdr point) (* ss (cdr offset)))))
           points offsets))))

#(define (op58-native-free-tie-edge grob side)
  (let ((edges (hashq-ref op58-native-tie-free-edges grob #f)))
    (if (not edges)
      (let ((native (op58-tie-source-points grob)))
        (set! edges (cons (caar native) (car (list-ref native 3))))
        (hashq-set! op58-native-tie-free-edges grob edges)))
    (if (= side LEFT) (car edges) (cdr edges))))

#(define (op58-frozen-tie-points grob row)
  (and row
    (let* ((sid (assoc-get 'data-sid
                   (ly:grob-property grob 'output-attributes '()) #f))
           (owners (cadr row))
           (left (and owners (op58-same-system-head (car owners) grob)))
           (right (and owners (op58-same-system-head (cdr owners) grob)))
           (mode (car row)) (offsets (cddr row))
           (ss (ly:staff-symbol-staff-space grob)))
      (and (or left (eq? mode 'left-free-right-real))
           (or right (eq? mode 'left-real-right-free))
        (let* ((lx (if left (op58-head-centre left grob X)
                     (op58-native-free-tie-edge grob LEFT)))
               (ly (op58-head-centre (or left right) grob Y))
               (rx (if right (op58-head-centre right grob X)
                     (op58-native-free-tie-edge grob RIGHT)))
               (ry (if right (op58-head-centre right grob Y) ly)))
          (map (lambda (offset index)
                 (cons (+ (if (< index 2) lx rx) (* ss (car offset)))
                       (+ (if (< index 2) ly ry) (* ss (cdr offset)))))
               offsets '(0 1 2 3)))))))

#(define (op58-reviewed-tie-points grob)
  (let* ((sid (assoc-get 'data-sid
                (ly:grob-property grob 'output-attributes '()) #f))
         (fixed-fragments (and sid (assoc-get sid op58-tie-frozen-points #f)))
         (fixed-row (and fixed-fragments
                         (assoc-get (op58-fragment-index grob) fixed-fragments #f)))
         (fixed-points (op58-frozen-tie-points grob fixed-row))
         (fragments (and sid (assoc-get sid op58-tie-point-offsets #f)))
         (offsets (and fragments
                      (assoc-get (op58-fragment-index grob) fragments #f)))
         (points (or fixed-points (op58-tie-source-points grob)))
         (ss (ly:staff-symbol-staff-space grob)))
    (if (or fixed-points (not offsets)) points
      (map (lambda (point offset)
             (cons (+ (car point) (* ss (car offset)))
                   (+ (cdr point) (* ss (cdr offset)))))
           points offsets))))

% TieColumn may assign sibling Tie control-points directly while resolving a
% chord, bypassing a per-Tie callback that has not yet been evaluated.  Reapply
% only the reviewed source-head-frozen targets after line breaking, when real
% NoteHeads and their System are final.  Other native Ties are untouched.
#(define (op58-finalize-frozen-tie grob)
  (let* ((sid (assoc-get 'data-sid
                (ly:grob-property grob 'output-attributes '()) #f))
         (fragments (and sid (assoc-get sid op58-tie-frozen-points #f)))
         (row (and fragments
                   (assoc-get (op58-fragment-index grob) fragments #f))))
    (if row
      (begin
        ;; Complete native TieColumn positioning before assigning the target.
        (ly:grob-property grob 'control-points)
        (let ((fixed (op58-frozen-tie-points grob row)))
          (if fixed
            (begin
              (ly:grob-set-property! grob 'control-points fixed)
              (let ((stencil (ly:tie::print grob)))
                (ly:grob-set-property! grob 'stencil stencil)
                (ly:grob-set-property! grob 'X-extent
                  (ly:stencil-extent stencil X))
                (ly:grob-set-property! grob 'Y-extent
                  (ly:stencil-extent stencil Y)))
              (if (defined? 'concerto-audit-wrap-pdf-stencil!)
                (concerto-audit-wrap-pdf-stencil! grob)))))))))

% Source-identified, local continuous Slur deformation.  Preserve the original
% native Slur, endpoint identity, paint thickness and spacing extents.  Only
% the documented interior span yields to the three enharmonic native ties.
#(define (op58-cubic-at points t)
  (let ((u (- 1 t)))
    (cons
      (+ (* u u u (caar points)) (* 3 u u t (caadr points))
         (* 3 u t t (caaddr points)) (* t t t (car (list-ref points 3))))
      (+ (* u u u (cdar points)) (* 3 u u t (cdadr points))
         (* 3 u t t (cdaddr points)) (* t t t (cdr (list-ref points 3)))))))
#(define (op58-cubic-derivative points t)
  (let ((u (- 1 t)))
    (cons
      (+ (* 3 u u (- (caadr points) (caar points)))
         (* 6 u t (- (caaddr points) (caadr points)))
         (* 3 t t (- (car (list-ref points 3)) (caaddr points))))
      (+ (* 3 u u (- (cdadr points) (cdar points)))
         (* 6 u t (- (cdaddr points) (cdadr points)))
         (* 3 t t (- (cdr (list-ref points 3)) (cdaddr points)))))))
#(define (op58-dip-value x knots amount)
  (let ((a (list-ref knots 0)) (b (list-ref knots 1))
        (c (list-ref knots 2)) (d (list-ref knots 3)))
    (cond ((or (<= x a) (>= x d)) '(0 . 0))
      ((<= x b)
        (let ((u (/ (- x a) (- b a))))
          (cons (* amount u u (- 3 (* 2 u)))
                (* amount (/ (* 6 u (- 1 u)) (- b a))))))
      ((<= x c) (cons amount 0))
      (else
        (let ((u (/ (- x c) (- d c))))
          (cons (* amount (- 1 (* u u (- 3 (* 2 u)))))
                (* -1 amount (/ (* 6 u (- 1 u)) (- d c)))))))))
#(define (op58-warped-cubic points knots amount)
  (define (position t)
    (let* ((p (op58-cubic-at points t))
           (delta (op58-dip-value (car p) knots amount)))
      (cons (car p) (+ (cdr p) (car delta)))))
  (define (derivative t)
    (let* ((p (op58-cubic-at points t))
           (v (op58-cubic-derivative points t))
           (delta (op58-dip-value (car p) knots amount)))
      (cons (car v) (+ (cdr v) (* (cdr delta) (car v))))))
  (apply append
    (map (lambda (i)
      (let* ((a (/ i 128)) (b (/ (+ i 1) 128)) (h (/ (- b a) 3))
             (p0 (position a)) (p3 (position b))
             (v0 (derivative a)) (v3 (derivative b)))
        (list 'curveto (+ (car p0) (* h (car v0)))
              (+ (cdr p0) (* h (cdr v0)))
              (- (car p3) (* h (car v3)))
              (- (cdr p3) (* h (cdr v3)))
              (car p3) (cdr p3))))
      (iota 128))))
#(define (op58-local-slur-dip grob)
  (let* ((native (ly:slur::print grob))
         (expr (ly:stencil-expr native))
         (head (op58-same-system-head "n1-3518" grob)))
    (if (and head (pair? expr) (eq? (car expr) 'path))
      (let* ((ss (ly:staff-symbol-staff-space grob))
             (anchor (op58-head-centre head grob X))
             (knots (map (lambda (x) (+ anchor (* ss x)))
                         '(-4.185955 -0.823742 6.417948 9.780161)))
             (amount (* ss -1.112117))
             (path (list-ref expr 2)))
        (let walk ((tokens path) (current '(0 . 0)) (result '()))
          (cond
            ((null? tokens)
              (make-path-stencil result (cadr expr) 1 1 #t
                #:line-cap-style (list-ref expr 3)
                #:line-join-style (list-ref expr 4)))
            ((memq (car tokens) '(moveto lineto))
              (let* ((x (cadr tokens)) (y (caddr tokens))
                     (delta (op58-dip-value x knots amount)))
                (walk (cdddr tokens) (cons x y)
                  (append result (list (car tokens) x (+ y (car delta)))))))
            ((eq? (car tokens) 'curveto)
              (let* ((p1 (cons (list-ref tokens 1) (list-ref tokens 2)))
                     (p2 (cons (list-ref tokens 3) (list-ref tokens 4)))
                     (p3 (cons (list-ref tokens 5) (list-ref tokens 6))))
                (walk (list-tail tokens 7) p3
                  (append result
                    (op58-warped-cubic (list current p1 p2 p3) knots amount)))))
            ((eq? (car tokens) 'closepath)
              (walk (cdr tokens) current (append result '(closepath))))
            (else native))))
      native)))

% During pure spacing, source Script positions must not read foreign
% cross-staff Stems.  Their final unpure callback is captured unchanged.
#(define (op58-own-notehead-script-pure-y grob)
  (let* ((attrs (ly:grob-property grob 'output-attributes '()))
         (nid (assoc-get 'data-nid attrs #f))
         (head (and nid (hash-ref op58-noteheads-by-nid nid #f)))
         (column (and (ly:grob? head) (ly:grob-parent head X)))
         (array (and (ly:grob? column) (ly:grob-object column 'note-heads)))
         (heads (if (ly:grob-array? array) (ly:grob-array->list array)
                    (if (ly:grob? head) (list head) '())))
         (positions (map (lambda (h) (ly:grob-property h 'staff-position 0)) heads))
         (direction (ly:grob-property grob 'direction UP))
         (edge (if (null? positions) (* direction 4)
                   (apply (if (> direction 0) max min) positions))))
    (* (ly:staff-symbol-staff-space grob)
       (+ (* 0.5 edge) (* direction 0.75)))))
#(define (op58-script-pure-local-engraver context)
  (make-engraver
    (acknowledgers
      ((script-interface engraver grob source-engraver)
        (let ((old (ly:grob-property-data grob 'Y-offset)))
          (if (or (ly:unpure-pure-container? old) (procedure? old))
            (ly:grob-set-property! grob 'Y-offset
              (ly:make-unpure-pure-container
                (lambda (g)
                  (if (ly:unpure-pure-container? old)
                      (ly:unpure-call old g) (old g)))
                (lambda (g start end)
                  (op58-own-notehead-script-pure-y g))))))))))

#(define op58-local-slur-height
  (ly:make-unpure-pure-container
    (lambda (grob)
      (ly:stencil-extent (ly:grob-property grob 'stencil) Y))
    ly:slur::pure-height))



